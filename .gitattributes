# Normalise line endings to LF regardless of the contributor's git config.
# .editorconfig covers editors; this covers git itself, so a clone with
# core.autocrlf=true cannot churn every file in the repo.
* text=auto eol=lf

# Never touch binary assets.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
